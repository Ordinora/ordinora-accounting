# Copy to .env.oracle-staging only on the Oracle VM. Never commit the populated file.
NODE_ENV=production
DEPLOYMENT_ENV=staging
ALLOW_STAGING_LOCAL_STORAGE=true
APP_URL=https://accounts-staging.your-domain.example
INSTANCE_ID=oracle-staging-01

SESSION_SECRET=replace-with-a-unique-32-plus-character-secret
MFA_ENCRYPTION_KEY=replace-with-a-different-32-plus-character-secret
MFA_ENCRYPTION_KEY_PREVIOUS=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
HEALTH_CHECK_TOKEN=replace-with-another-unique-32-plus-character-secret

DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_ROOT=/var/lib/ordinora/documents
DOCUMENT_MALWARE_SCAN_MODE=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
UPLOAD_MAX_BYTES=10485760
DOCUMENT_AI_PROVIDER=mock

# Compose interpolation variables (also place them in a root .env on the VM).
STAGING_DOMAIN=accounts-staging.your-domain.example
POSTGRES_APP_PASSWORD=replace-with-a-long-random-database-password
ORDINORA_RELEASE=staging
