# Store real values in the hosting platform's secret manager. Do not deploy this file.
NODE_ENV="production"
DATABASE_URL="postgresql://ordinora_app:replace-with-password@postgres-host:5432/ordinora_staging?schema=public&sslmode=require"
APP_URL="https://staging.example.com"
INSTANCE_ID="staging-01"

# Generate four separate cryptographically random values. Never reuse them.
SESSION_SECRET="replace-with-at-least-32-random-bytes"
MFA_ENCRYPTION_KEY="replace-with-a-different-random-secret-at-least-32-characters"
MFA_ENCRYPTION_KEY_PREVIOUS=""
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
HEALTH_CHECK_TOKEN="replace-with-another-random-secret-at-least-32-characters"

UPLOAD_MAX_BYTES="10485760"
DOCUMENT_STORAGE_PROVIDER="azure"
AZURE_BLOB_CONTAINER_URL="https://replace.blob.core.windows.net/accounting-documents-staging"
AZURE_BLOB_SAS_TOKEN="replace-with-container-scoped-private-sas-token"
DOCUMENT_MALWARE_SCAN_MODE="clamav"

# AI document extraction remains disabled until separately approved.
DOCUMENT_AI_PROVIDER="mock"
