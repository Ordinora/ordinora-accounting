{
  "name": "ordinora-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:cycle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-e2e-cycle.ps1",
    "test:accounting-performance": "tsx scripts/accounting-performance-check.ts",
    "test:accounting-concurrency": "tsx scripts/accounting-concurrency-check.ts",
    "db:performance-fixture": "tsx scripts/generate-performance-fixture.ts",
    "db:e2e:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-e2e-db.ps1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "config:check": "tsx scripts/check-production-config.ts",
    "db:seed": "tsx prisma/seed.ts"
    ,"db:expand-chart": "tsx prisma/expand-chart.ts"
    ,"db:seed-commercial": "tsx prisma/seed-commercial.ts"
    ,"db:seed-inventory": "tsx prisma/seed-inventory.ts"
    ,"db:seed-payroll": "tsx prisma/seed-payroll.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^6.16.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
