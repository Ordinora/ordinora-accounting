  foreignAmount         Decimal         @db.Decimal(19, 4)
  discountInput         String?
  discountForeignAmount Decimal         @default(0) @db.Decimal(19, 4)
  discountBaseAmount    Decimal         @default(0) @db.Decimal(19, 4)
  carryingBaseAmount    Decimal         @db.Decimal(19, 4)
  settlementBaseAmount  Decimal         @db.Decimal(19, 4)
  realizedFxBase        Decimal         @db.Decimal(19, 4)
  payment               SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bill                  SupplierBill    @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([paymentId, billId])
  @@index([billId])
}

model Payment {
  id                    String           @id @default(cuid())
  tenantId              String
  periodId              String
  bankAccountId         String
  reference             String
  paymentDate           DateTime         @db.Date
  payee                 String
  description           String?
  currency              String
  exchangeRate          Decimal          @db.Decimal(24, 12)
  foreignSubtotal       Decimal          @default(0) @db.Decimal(19, 4)
  discountType          String           @default("NONE")
  discountValue         Decimal          @default(0) @db.Decimal(19, 4)
  discountAmount        Decimal          @default(0) @db.Decimal(19, 4)
  foreignAmount         Decimal          @db.Decimal(19, 4)
  baseAmount            Decimal          @db.Decimal(19, 4)
  journalId             String?          @unique
  createdById           String
  postedAt              DateTime         @default(now())
  paymentMethod         String           @default("BANK_TRANSFER")
  chequeNumber          String?
  chequeDate            DateTime?        @db.Date
  chequeStatus          String?
  chequeClearedOn       DateTime?        @db.Date
  chequeReturnedOn      DateTime?        @db.Date
  chequeReturnReason    String?
  chequeReturnJournalId String?
  tenant                Tenant           @relation(fields: [tenantId], references: [id])
  period                AccountingPeriod @relation(fields: [periodId], references: [id])
  bankAccount           Account          @relation(fields: [bankAccountId], references: [id])
  lines                 PaymentLine[]

  @@unique([tenantId, reference])
  @@index([tenantId, paymentDate])
}

model PaymentLine {
  id                  String             @id @default(cuid())
  paymentId           String
  accountId           String
  inventoryItemId     String?
  inventoryLocationId String?
  description         String
  quantity            Decimal            @db.Decimal(19, 4)
  unitPrice           Decimal            @db.Decimal(19, 4)
  discountPercent     Decimal            @default(0) @db.Decimal(9, 4)
  discountAmount      Decimal            @default(0) @db.Decimal(19, 4)
  foreignAmount       Decimal            @db.Decimal(19, 4)
  baseAmount          Decimal            @db.Decimal(19, 4)
  payment             Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  account             Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  inventoryItem       InventoryItem?     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryLocation   InventoryLocation? @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([accountId])
  @@index([inventoryItemId])
  @@index([inventoryLocationId])
}

model InterAccountTransfer {
  id                      String           @id @default(cuid())
  tenantId                String
  periodId                String
  sourceAccountId         String
  destinationAccountId    String
  reference               String
  transferDate            DateTime         @db.Date
  description             String?
  sourceCurrency          String
  sourceAmount            Decimal          @db.Decimal(19, 4)
  sourceExchangeRate      Decimal          @db.Decimal(24, 12)
  sourceBaseAmount        Decimal          @db.Decimal(19, 4)
  destinationCurrency     String
  destinationAmount       Decimal          @db.Decimal(19, 4)
  destinationExchangeRate Decimal          @db.Decimal(24, 12)
  destinationBaseAmount   Decimal          @db.Decimal(19, 4)
  realizedFxBase          Decimal          @default(0) @db.Decimal(19, 4)
  journalId               String?          @unique
  createdById             String
  postedAt                DateTime         @default(now())
  tenant                  Tenant           @relation(fields: [tenantId], references: [id])
  period                  AccountingPeriod @relation(fields: [periodId], references: [id])
  sourceAccount           Account          @relation("TransferSourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount      Account          @relation("TransferDestinationAccount", fields: [destinationAccountId], references: [id])

  @@unique([tenantId, reference])
  @@index([tenantId, transferDate])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
}

model BankReconciliation {
  id                      String                   @id @default(cuid())
  tenantId                String
  accountId               String
  reference               String
  statementStart          DateTime                 @db.Date
  statementEnd            DateTime                 @db.Date
  statementClosingBalance Decimal                  @db.Decimal(19, 4)
  status                  BankReconciliationStatus @default(DRAFT)
  createdById             String
  reconciledById          String?
  reconciledAt            DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  account                 Account                  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  clearedLines            BankReconciliationLine[]

  @@unique([tenantId, reference])
  @@index([tenantId, accountId, statementEnd])
}

model BankReconciliationLine {
  id               String             @id @default(cuid())
  reconciliationId String
  journalLineId    String
  clearedAt        DateTime           @default(now())
  reconciliation   BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  journalLine      JournalLine        @relation(fields: [journalLineId], references: [id], onDelete: Restrict)

  @@unique([reconciliationId, journalLineId])
  @@unique([journalLineId])
}

model BankStatementImport {
  id           String              @id @default(cuid())
  tenantId     String
  accountId    String
  originalName String
  importedById String
  importedAt   DateTime            @default(now())
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  account      Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lines        BankStatementLine[]

  @@index([tenantId, importedAt])
}

model BankStatementLine {
  id                   String                  @id @default(cuid())
  importId             String
  transactionDate      DateTime                @db.Date
  reference            String?
  description          String
  amount               Decimal                 @db.Decimal(19, 4)
  status               BankStatementLineStatus @default(UNMATCHED)
  matchedJournalLineId String?                 @unique
  importedStatement    BankStatementImport     @relation(fields: [importId], references: [id], onDelete: Cascade)
  matchedJournalLine   JournalLine?            @relation(fields: [matchedJournalLineId], references: [id], onDelete: Restrict)

  @@index([importId, transactionDate])
}

model DailyCashRegister {
  id                  String              @id @default(cuid())
  tenantId            String
  periodId            String
  cashAccountId       String
  reference           String
  registerDate        DateTime            @db.Date
  branchLabel         String?
  registerLabel       String?
  currency            String
  openingFloat        Decimal             @db.Decimal(19, 4)
  salesTotal          Decimal             @db.Decimal(19, 4)
  cashTenderTotal     Decimal             @db.Decimal(19, 4)
  expectedClosingCash Decimal             @db.Decimal(19, 4)
  actualClosingCash   Decimal             @db.Decimal(19, 4)
  cashVariance        Decimal             @db.Decimal(19, 4)
  journalId           String?             @unique
  createdById         String
  postedAt            DateTime            @default(now())
  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  period              AccountingPeriod    @relation(fields: [periodId], references: [id])
  cashAccount         Account             @relation(fields: [cashAccountId], references: [id])
  lines               DailyCashSaleLine[]
  tenders             DailyCashTender[]

  @@unique([tenantId, reference])
  @@index([tenantId, registerDate])
}

model DailyCashSaleLine {
  id                  String             @id @default(cuid())
  registerId          String
  revenueAccountId    String
  inventoryItemId     String?
  inventoryLocationId String?
  description         String
  quantity            Decimal            @db.Decimal(19, 4)
  unitPrice           Decimal            @db.Decimal(19, 4)
  discountPercent     Decimal            @default(0) @db.Decimal(9, 4)
  discountAmount      Decimal            @default(0) @db.Decimal(19, 4)
  lineTotal           Decimal            @db.Decimal(19, 4)
  register            DailyCashRegister  @relation(fields: [registerId], references: [id], onDelete: Restrict)
  revenueAccount      Account            @relation(fields: [revenueAccountId], references: [id], onDelete: Restrict)
  inventoryItem       InventoryItem?     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryLocation   InventoryLocation? @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId])
  @@index([inventoryLocationId])
}

model DailyCashTender {
  id         String            @id @default(cuid())
  registerId String
  type       TenderType
  accountId  String
  amount     Decimal           @db.Decimal(19, 4)
  reference  String?
  register   DailyCashRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)
  account    Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

model InventoryItem {
  id                     String                  @id @default(cuid())
  tenantId               String
  sku                    String
  name                   String
  description            String?
  unitName               String                  @default("unit")
  inventoryAccountId     String
  revenueAccountId       String
  cogsAccountId          String
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  inventoryAccount       Account                 @relation("InventoryAssetAccount", fields: [inventoryAccountId], references: [id])
  revenueAccount         Account                 @relation("InventoryRevenueAccount", fields: [revenueAccountId], references: [id])
  cogsAccount            Account                 @relation("InventoryCogsAccount", fields: [cogsAccountId], references: [id])
  balances               InventoryBalance[]
  movements              InventoryMovement[]
  operations             InventoryOperation[]
  salesInvoiceLines      SalesInvoiceLine[]
  salesQuotationLines    SalesQuotationLine[]
  salesOrderLines        SalesOrderLine[]
  supplierQuotationLines SupplierQuotationLine[]
  purchaseOrderLines     PurchaseOrderLine[]
  supplierBillLines      SupplierBillLine[]
  paymentLines           PaymentLine[]
  dailyCashSaleLines     DailyCashSaleLine[]
  costLayers             InventoryCostLayer[]

  @@unique([tenantId, sku])
  @@index([tenantId, name])
}

model InventoryLocation {
  id                     String                  @id @default(cuid())
  tenantId               String
  code                   String
  name                   String
  branchLabel            String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  balances               InventoryBalance[]
  movements              InventoryMovement[]
  salesInvoiceLines      SalesInvoiceLine[]
  salesQuotationLines    SalesQuotationLine[]
  salesOrderLines        SalesOrderLine[]
  supplierQuotationLines SupplierQuotationLine[]
  purchaseOrderLines     PurchaseOrderLine[]
  supplierBillLines      SupplierBillLine[]
  paymentLines           PaymentLine[]
  dailyCashSaleLines     DailyCashSaleLine[]
  sourceOperations       InventoryOperation[]    @relation("InventoryOperationSource")
  destinationOperations  InventoryOperation[]    @relation("InventoryOperationDestination")
  costLayers             InventoryCostLayer[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
}

model InventoryBalance {
  id             String            @id @default(cuid())
  itemId         String
  locationId     String
  quantity       Decimal           @default(0) @db.Decimal(19, 4)
  inventoryValue Decimal           @default(0) @db.Decimal(19, 4)
  updatedAt      DateTime          @updatedAt
  item           InventoryItem     @relation(fields: [itemId], references: [id])
  location       InventoryLocation @relation(fields: [locationId], references: [id])

  @@unique([itemId, locationId])
  @@index([locationId])
}

model InventoryMovement {
  id           String                @id @default(cuid())
  tenantId     String
  itemId       String
  locationId   String
  operationId  String?
  type         InventoryMovementType
  movementDate DateTime              @db.Date
  quantity     Decimal               @db.Decimal(19, 4)
  unitCost     Decimal               @db.Decimal(19, 4)
  totalCost    Decimal               @db.Decimal(19, 4)
  reference    String
  sourceType   String?
  sourceId     String?
  notes        String?
  createdById  String
  createdAt    DateTime              @default(now())
  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  item         InventoryItem         @relation(fields: [itemId], references: [id])
  location     InventoryLocation     @relation(fields: [locationId], references: [id])
  operation    InventoryOperation?   @relation(fields: [operationId], references: [id])

  @@index([tenantId, movementDate])
  @@index([tenantId, itemId, movementDate])
  @@index([itemId, locationId, movementDate])
}

model InventoryCostLayer {
  id                String            @id @default(cuid())
  tenantId          String
  itemId            String
  locationId        String
  receivedOn        DateTime          @db.Date
  sourceType        String
  sourceId          String?
  originalQuantity  Decimal           @db.Decimal(19, 4)
  remainingQuantity Decimal           @db.Decimal(19, 4)
  unitCost          Decimal           @db.Decimal(19, 4)
  createdAt         DateTime          @default(now())
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item              InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([tenantId, itemId, locationId, receivedOn, createdAt])
  @@index([tenantId, remainingQuantity])
}

model InventoryOperation {
  id                    String                 @id @default(cuid())
  tenantId              String
  periodId              String
  itemId                String
  type                  InventoryOperationType
  reference             String
  operationDate         DateTime               @db.Date
  sourceLocationId      String?
  destinationLocationId String?
  offsetAccountId       String?
  quantity              Decimal                @db.Decimal(19, 4)
  unitCost              Decimal                @db.Decimal(19, 4)
  totalCost             Decimal                @db.Decimal(19, 4)
  reason                String
  journalId             String?                @unique
  createdById           String
  createdAt             DateTime               @default(now())
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  period                AccountingPeriod       @relation(fields: [periodId], references: [id])
  item                  InventoryItem          @relation(fields: [itemId], references: [id])
  sourceLocation        InventoryLocation?     @relation("InventoryOperationSource", fields: [sourceLocationId], references: [id])
  destinationLocation   InventoryLocation?     @relation("InventoryOperationDestination", fields: [destinationLocationId], references: [id])
  offsetAccount         Account?               @relation(fields: [offsetAccountId], references: [id])
  movements             InventoryMovement[]

  @@unique([tenantId, reference])
  @@index([tenantId, operationDate])
}

model Journal {
  id             String           @id @default(cuid())
  tenantId       String
  periodId       String
  reference      String
  description    String
  accountingDate DateTime         @db.Date
  status         JournalStatus    @default(DRAFT)
  source         JournalSource
  sourceId       String?
  createdById    String
  reviewedById   String?
  approvedById   String?
  postedById     String?
  postedAt       DateTime?
  reversalOfId   String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  period         AccountingPeriod @relation(fields: [periodId], references: [id])
  creator        User             @relation("JournalCreator", fields: [createdById], references: [id])
  reviewer       User?            @relation("JournalReviewer", fields: [reviewedById], references: [id])
  approver       User?            @relation("JournalApprover", fields: [approvedById], references: [id])
  poster         User?            @relation("JournalPoster", fields: [postedById], references: [id])
  reversalOf     Journal?         @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversal       Journal?         @relation("JournalReversal")
  lines          JournalLine[]

  @@unique([tenantId, reference])
  @@index([tenantId, accountingDate, status])
}

model JournalLine {
  id                  String                   @id @default(cuid())
  journalId           String
  accountId           String
  description         String?
  debit               Decimal                  @default(0) @db.Decimal(19, 4)
  credit              Decimal                  @default(0) @db.Decimal(19, 4)
  currencyCode        String?
  exchangeRate        Decimal?                 @db.Decimal(24, 12)
  foreignDebit        Decimal?                 @db.Decimal(19, 4)
  foreignCredit       Decimal?                 @db.Decimal(19, 4)
  journal             Journal                  @relation(fields: [journalId], references: [id], onDelete: Restrict)
  account             Account                  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reconciliationLines BankReconciliationLine[]
  bankStatementMatch  BankStatementLine?

  @@index([journalId])
  @@index([accountId])
}

model ReportVersion {
  id              String           @id @default(cuid())
  tenantId        String
  periodId        String
  reportType      String
  state           ReportState      @default(DRAFT)
  version         Int
  payload         Json
  disclaimer      String?
  accountantNote  String?
  latestPostingAt DateTime?
  publishedAt     DateTime?
  publishedById   String?
  supersedesId    String?          @unique
  createdAt       DateTime         @default(now())
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  period          AccountingPeriod @relation(fields: [periodId], references: [id])
  supersedes      ReportVersion?   @relation("ReportSupersession", fields: [supersedesId], references: [id])
  replacement     ReportVersion?   @relation("ReportSupersession")

  @@unique([tenantId, periodId, reportType, version])
  @@index([tenantId, state])
}

model Document {
  id                 String              @id @default(cuid())
  tenantId           String
  uploadedById       String
  originalName       String
  storageKey         String              @unique
  contentType        String
  sizeBytes          Int
  checksum           String
  status             DocumentStatus      @default(SCAN_PENDING)
  scannedAt          DateTime?
  scanEngine         String?
  scanResult         String?
  quarantineReason   String?
  createdAt          DateTime            @default(now())
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  questions          Question[]
  accountingDocument AccountingDocument?

  @@index([tenantId, status])
}

model AccountingDocument {
  id                       String                  @id @default(cuid())
  tenantId                 String
  documentId               String                  @unique
  requestedType            AccountingDocumentType?
  detectedType             AccountingDocumentType?
  confirmedType            AccountingDocumentType?
  classificationConfidence Decimal?                @db.Decimal(7, 4)
  status                   AIProcessingStatus      @default(UPLOADED)
  provider                 String
  model                    String?
  extractedData            Json?
  confirmedData            Json?
  validationResults        Json?
  duplicateOfId            String?
  relatedEntityType        String?
  relatedEntityId          String?
  postedEntityType         String?
  postedEntityId           String?
  processedAt              DateTime?
  reviewedById             String?
  reviewedAt               DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id])
  document                 Document                @relation(fields: [documentId], references: [id], onDelete: Restrict)
  duplicateOf              AccountingDocument?     @relation("AccountingDocumentDuplicate", fields: [duplicateOfId], references: [id])
  possibleDuplicates       AccountingDocument[]    @relation("AccountingDocumentDuplicate")
  jobs                     DocumentProcessingJob[]
  suggestions              DocumentSuggestion[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, detectedType])
}

model DocumentProcessingJob {
  id                   String             @id @default(cuid())
  accountingDocumentId String
  stage                AIProcessingStatus
  provider             String
  attempt              Int                @default(1)
  errorCode            String?
  errorMessage         String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime           @default(now())
  accountingDocument   AccountingDocument @relation(fields: [accountingDocumentId], references: [id], onDelete: Restrict)

  @@index([accountingDocumentId, createdAt])
}

model DocumentSuggestion {
  id                   String             @id @default(cuid())
  accountingDocumentId String
  suggestionType       String
  proposedValue        Json
  confirmedValue       Json?
  confidence           Decimal            @db.Decimal(7, 4)
  reason               String
  status               AISuggestionStatus @default(PENDING)
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime           @default(now())
  accountingDocument   AccountingDocument @relation(fields: [accountingDocumentId], references: [id], onDelete: Restrict)

  @@index([accountingDocumentId, status])
}

model Question {
  id            String            @id @default(cuid())
  tenantId      String
  documentId    String?
  subject       String
  status        QuestionStatus    @default(OPEN)
  clientVisible Boolean           @default(true)
  createdAt     DateTime          @default(now())
  resolvedAt    DateTime?
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  document      Document?         @relation(fields: [documentId], references: [id])
  messages      QuestionMessage[]

  @@index([tenantId, status])
}

model QuestionMessage {
  id           String   @id @default(cuid())
  questionId   String
  authorId     String
  body         String
  internalOnly Boolean  @default(false)
  createdAt    DateTime @default(now())
  question     Question @relation(fields: [questionId], references: [id])

  @@index([questionId, createdAt])
}

model AuditEvent {
  id             String    @id @default(cuid())
  firmId         String
  tenantId       String?
  actorId        String?
  actorKind      UserKind?
  action         String
  entityType     String?
  entityId       String?
  previousValues Json?
  newValues      Json?
  reason         String?
  sourceMetadata Json?
  createdAt      DateTime  @default(now())
  tenant         Tenant?   @relation(fields: [tenantId], references: [id])
  actor          User?     @relation(fields: [actorId], references: [id])

  @@index([firmId, tenantId, createdAt])
  @@index([entityType, entityId])
}
