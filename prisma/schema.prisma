generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserKind {
  STAFF
  CLIENT
}

enum StaffRole {
  SYSTEM_ADMIN
  FIRM_ADMIN
  ACCOUNTANT
  PAYROLL_OFFICER
  REVIEWER
  READ_ONLY
}

enum ClientRole {
  CLIENT_ADMIN
  CLIENT_DIRECTOR
  CLIENT_FINANCE_VIEWER
  CLIENT_PAYROLL_VIEWER
  CLIENT_DOCUMENT_CONTRIBUTOR
}

enum EntityType {
  PRIVATE_LIMITED
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  OTHER
}

enum TenantStatus {
  ACTIVE
  DORMANT
}

enum PortalReportMode {
  PUBLISHED_ONLY
  LIVE_POSTED_AND_PUBLISHED
}

enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
  FINALIZED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountControlRole {
  TRADE_RECEIVABLES
  TRADE_PAYABLES
}

enum JournalStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  POSTED
  REVERSED
}

enum BankReconciliationStatus {
  DRAFT
  RECONCILED
}

enum BankStatementLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

enum JournalSource {
  MANUAL
  OPENING_BALANCE
  YEAR_END_CLOSE
  SALES_INVOICE
  SALES_CREDIT_NOTE
  CUSTOMER_RECEIPT
  SUPPLIER_BILL
  SUPPLIER_CREDIT_NOTE
  SUPPLIER_PAYMENT
  PAYMENT
  INTER_ACCOUNT_TRANSFER
  REVERSAL
  ADJUSTMENT
  DAILY_CASH_SALES
  INVENTORY_ADJUSTMENT
  PAYROLL
  FIXED_ASSET_DEPRECIATION
  FIXED_ASSET_DISPOSAL
  PAYROLL_PAYMENT
}

enum TenderType {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum InventoryMovementType {
  OPENING
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  SALES_RETURN
  PURCHASE_RETURN
}

enum InventoryOperationType {
  TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum InventoryCostingMethod {
  WEIGHTED_AVERAGE
  FIFO
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum PayFrequency {
  MONTHLY
  HOURLY
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  POSTED
  LOCKED
}

enum PayrollRunType {
  REGULAR
  FINAL_PAY
}

enum ReportState {
  DRAFT
  LIVE_POSTED
  PUBLISHED
  FINALIZED
  SUPERSEDED
}

enum DocumentStatus {
  SCAN_PENDING
  QUARANTINED
  UPLOADED
  UNDER_REVIEW
  INFORMATION_REQUIRED
  ACCEPTED
  LINKED_TO_TRANSACTION
  REJECTED
  ARCHIVED
}

enum AccountingDocumentType {
  PURCHASE_INVOICE
  SALES_INVOICE
  RECEIPT
  EXPENSE_CLAIM
  BANK_STATEMENT
  DELIVERY_ORDER
  CREDIT_NOTE
  DEBIT_NOTE
  SUPPLIER_STATEMENT
  OTHER
}

enum AIProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  OCR_PROCESSING
  EXTRACTING
  VALIDATING
  MATCHING
  CATEGORISING
  REVIEW_REQUIRED
  APPROVED
  POSTED
  FAILED
  CANCELLED
}

enum AISuggestionStatus {
  PENDING
  ACCEPTED
  EDITED
  REJECTED
}

enum QuestionStatus {
  OPEN
  ANSWERED
  RESOLVED
  REOPENED
}

enum TaxWorkingStatus {
  DRAFT
  PREPARING
  READY_TO_FILE
  FILED
  OVERDUE
  NOT_REQUIRED
}

enum ComplianceTaskStatus {
  OPEN
  COMPLETED
  DISMISSED
}

enum CapitalAllowanceItemStatus {
  ACTIVE
  DISPOSED
  EXCLUDED
}

enum FixedAssetStatus {
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
  INACTIVE
}

enum DepreciationMethod {
  STRAIGHT_LINE
}

enum CommercialDocumentStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOIDED
}

enum SalesQuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  READY_TO_INVOICE
  CONVERTED
  CANCELLED
}

enum SupplierQuotationStatus {
  RECEIVED
  SELECTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  PARTIALLY_BILLED
  BILLED
  CANCELLED
}

model Firm {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  users         User[]
  tenants       Tenant[]
  loginAttempts LoginAttempt[]
}

model User {
  id                              String                  @id @default(cuid())
  firmId                          String
  tenantId                        String?
  kind                            UserKind
  email                           String
  displayName                     String
  passwordHash                    String
  staffRole                       StaffRole?
  clientRole                      ClientRole?
  isActive                        Boolean                 @default(true)
  mfaEnrolledAt                   DateTime?
  mfaSecretEncrypted              String?
  mfaPendingSecretEncrypted       String?
  mfaRecoveryCodeHashes           String[]                @default([])
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt
  firm                            Firm                    @relation(fields: [firmId], references: [id])
  tenant                          Tenant?                 @relation("ClientUsers", fields: [tenantId], references: [id])
  assignments                     StaffTenantAssignment[]
  createdJournals                 Journal[]               @relation("JournalCreator")
  reviewedJournals                Journal[]               @relation("JournalReviewer")
  approvedJournals                Journal[]               @relation("JournalApprover")
  postedJournals                  Journal[]               @relation("JournalPoster")
  auditEvents                     AuditEvent[]
  sessions                        Session[]
  loginAttempts                   LoginAttempt[]
  mfaChallenges                   MfaChallenge[]
  createdPayrollRuns              PayrollRun[]
  completedMonthEndChecklistItems MonthEndChecklistItem[] @relation("MonthEndChecklistCompleter")
  createdSalesQuotations          SalesQuotation[]        @relation("SalesQuotationCreator")
  createdSalesOrders              SalesOrder[]            @relation("SalesOrderCreator")
  createdSupplierQuotations       SupplierQuotation[]     @relation("SupplierQuotationCreator")
  createdPurchaseOrders           PurchaseOrder[]         @relation("PurchaseOrderCreator")

  @@unique([firmId, email])
  @@index([tenantId])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  firmId     String?
  userId     String?
  emailHash  String
  sourceHash String
  succeeded  Boolean
  createdAt  DateTime @default(now())
  firm       Firm?    @relation(fields: [firmId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([emailHash, sourceHash, createdAt])
  @@index([userId, createdAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model MfaChallenge {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Tenant {
  id                            String                   @id @default(cuid())
  firmId                        String
  legalName                     String
  tradingName                   String?
  registrationNumber            String?
  email                         String?
  entityType                    EntityType
  registeredAddress             String?
  primaryContact                String?
  financialYearEndMonth         Int
  financialYearEndDay           Int
  defaultCurrency               String                   @default("BND")
  multiCurrencyEnabled          Boolean                  @default(false)
  inventoryCostingMethod        InventoryCostingMethod   @default(WEIGHTED_AVERAGE)
  baseCurrencyLockedAt          DateTime?
  taxStatus                     String?
  status                        TenantStatus             @default(ACTIVE)
  portalEnabled                 Boolean                  @default(false)
  reportMode                    PortalReportMode         @default(PUBLISHED_ONLY)
  payrollVisibility             Boolean                  @default(false)
  documentUploadEnabled         Boolean                  @default(false)
  enabledDashboardCards         String[]
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  firm                          Firm                     @relation(fields: [firmId], references: [id])
  clientUsers                   User[]                   @relation("ClientUsers")
  assignments                   StaffTenantAssignment[]
  periods                       AccountingPeriod[]
  accounts                      Account[]
  journals                      Journal[]
  reports                       ReportVersion[]
  documents                     Document[]
  questions                     Question[]
  auditEvents                   AuditEvent[]
  customers                     Customer[]
  suppliers                     Supplier[]
  salesInvoices                 SalesInvoice[]
  salesQuotations               SalesQuotation[]
  salesOrders                   SalesOrder[]
  supplierQuotations            SupplierQuotation[]
  purchaseOrders                PurchaseOrder[]
  supplierBills                 SupplierBill[]
  salesCreditNotes              SalesCreditNote[]
  supplierCreditNotes           SupplierCreditNote[]
  customerReceipts              CustomerReceipt[]
  supplierPayments              SupplierPayment[]
  dailyCashRegisters            DailyCashRegister[]
  inventoryItems                InventoryItem[]
  inventoryLocations            InventoryLocation[]
  inventoryMovements            InventoryMovement[]
  inventoryOperations           InventoryOperation[]
  inventoryCostLayers           InventoryCostLayer[]
  employees                     Employee[]
  spkRateBands                  SpkRateBand[]
  payrollRuns                   PayrollRun[]
  accountingDocuments           AccountingDocument[]
  directPayments                Payment[]
  interAccountTransfers         InterAccountTransfer[]
  bankReconciliations           BankReconciliation[]
  bankStatementImports          BankStatementImport[]
  currencies                    TenantCurrency[]
  exchangeRates                 ExchangeRate[]
  taxYears                      TaxYear[]
  complianceTasks               ComplianceTask[]
  capitalAllowanceItems         CapitalAllowanceItem[]
  fixedAssets                   FixedAsset[]
  fixedAssetDepreciationEntries FixedAssetDepreciation[]
  fixedAssetDisposals           FixedAssetDisposal[]
  payrollSettlements            PayrollSettlement[]
  monthEndChecklistItems        MonthEndChecklistItem[]
  referenceSequences            ReferenceSequence[]

  @@unique([firmId, legalName])
}

model TaxYear {
  id                      String                 @id @default(cuid())
  tenantId                String
  year                    Int
  startsOn                DateTime               @db.Date
  endsOn                  DateTime               @db.Date
  filingDueOn             DateTime?              @db.Date
  status                  TaxWorkingStatus       @default(DRAFT)
  notes                   String?
  taxCompanyCategory      String                 @default("OTHER")
  taxRateMode             String                 @default("STANDARD")
  taxRate                 Decimal                @default(18.5) @db.Decimal(7, 4)
  chargeableIncome        Decimal                @default(0) @db.Decimal(19, 4)
  foreignIncome           Decimal                @default(0) @db.Decimal(19, 4)
  doubleTaxRelief         Decimal                @default(0) @db.Decimal(19, 4)
  tapTaxCredit            Decimal                @default(0) @db.Decimal(19, 4)
  localEmploymentCredit   Decimal                @default(0) @db.Decimal(19, 4)
  trainingTaxCredit       Decimal                @default(0) @db.Decimal(19, 4)
  exportSalesTax          Decimal                @default(0) @db.Decimal(19, 4)
  taxPaidEci              Decimal                @default(0) @db.Decimal(19, 4)
  priorYearTaxOffset      Decimal                @default(0) @db.Decimal(19, 4)
  withholdingTaxPaid      Decimal                @default(0) @db.Decimal(19, 4)
  taxComputationUpdatedAt DateTime?
  filedAt                 DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  capitalAllowanceItems   CapitalAllowanceItem[]

  @@unique([tenantId, year])
  @@index([tenantId, status, filingDueOn])
}

model CapitalAllowanceItem {
  id                    String                     @id @default(cuid())
  tenantId              String
  taxYearId             String
  assetCode             String
  description           String
  category              String
  acquiredOn            DateTime?                  @db.Date
  originalCost          Decimal                    @db.Decimal(19, 4)
  qualifyingAddition    Decimal                    @default(0) @db.Decimal(19, 4)
  taxWrittenDownValueBf Decimal                    @default(0) @db.Decimal(19, 4)
  disposalDeduction     Decimal                    @default(0) @db.Decimal(19, 4)
  initialAllowanceRate  Decimal                    @default(0) @db.Decimal(7, 4)
  annualAllowanceRate   Decimal                    @default(0) @db.Decimal(7, 4)
  privateUsePercent     Decimal                    @default(0) @db.Decimal(7, 4)
  status                CapitalAllowanceItemStatus @default(ACTIVE)
  notes                 String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  taxYear               TaxYear                    @relation(fields: [taxYearId], references: [id], onDelete: Restrict)

  @@unique([tenantId, taxYearId, assetCode])
  @@index([tenantId, taxYearId, status])
}

model FixedAsset {
  id                               String                   @id @default(cuid())
  tenantId                         String
  assetCode                        String
  name                             String
  category                         String
  description                      String?
  acquiredOn                       DateTime                 @db.Date
  depreciationStartsOn             DateTime                 @db.Date
  originalCost                     Decimal                  @db.Decimal(19, 4)
  residualValue                    Decimal                  @default(0) @db.Decimal(19, 4)
  openingAccumulatedDepreciation   Decimal                  @default(0) @db.Decimal(19, 4)
  usefulLifeMonths                 Int
  method                           DepreciationMethod       @default(STRAIGHT_LINE)
  assetAccountId                   String
  accumulatedDepreciationAccountId String
  depreciationExpenseAccountId     String
  location                         String?
  registrationNumber               String?
  sourceType                       String?
  sourceLineId                     String?
  sourceReference                  String?
  status                           FixedAssetStatus         @default(ACTIVE)
  disposedOn                       DateTime?                @db.Date
  disposalProceeds                 Decimal?                 @db.Decimal(19, 4)
  createdAt                        DateTime                 @default(now())
  updatedAt                        DateTime                 @updatedAt
  tenant                           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assetAccount                     Account                  @relation("FixedAssetCostAccount", fields: [assetAccountId], references: [id], onDelete: Restrict)
  accumulatedDepreciationAccount   Account                  @relation("FixedAssetAccumulatedAccount", fields: [accumulatedDepreciationAccountId], references: [id], onDelete: Restrict)
  depreciationExpenseAccount       Account                  @relation("FixedAssetExpenseAccount", fields: [depreciationExpenseAccountId], references: [id], onDelete: Restrict)
  depreciationEntries              FixedAssetDepreciation[]
  disposal                         FixedAssetDisposal?

  @@unique([tenantId, assetCode])
  @@unique([tenantId, sourceLineId])
  @@index([tenantId, status, acquiredOn])
}

model FixedAssetDepreciation {
  id               String           @id @default(cuid())
  tenantId         String
  fixedAssetId     String
  periodId         String
  depreciationDate DateTime         @db.Date
  amount           Decimal          @db.Decimal(19, 4)
  journalId        String           @unique
  createdById      String
  createdAt        DateTime         @default(now())
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fixedAsset       FixedAsset       @relation(fields: [fixedAssetId], references: [id], onDelete: Restrict)
  period           AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([fixedAssetId, depreciationDate])
  @@index([tenantId, depreciationDate])
}

model FixedAssetDisposal {
  id                      String           @id @default(cuid())
  tenantId                String
  fixedAssetId            String           @unique
  periodId                String
  disposalDate            DateTime         @db.Date
  proceeds                Decimal          @db.Decimal(19, 4)
  accumulatedDepreciation Decimal          @db.Decimal(19, 4)
  netBookValue            Decimal          @db.Decimal(19, 4)
  gainLoss                Decimal          @db.Decimal(19, 4)
  proceedsAccountId       String
  gainAccountId           String?
  lossAccountId           String?
  journalId               String           @unique
  reason                  String
  createdById             String
  createdAt               DateTime         @default(now())
  tenant                  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fixedAsset              FixedAsset       @relation(fields: [fixedAssetId], references: [id], onDelete: Restrict)
  period                  AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@index([tenantId, disposalDate])
}

model ComplianceTask {
  id          String               @id @default(cuid())
  tenantId    String
  title       String
  category    String
  dueOn       DateTime             @db.Date
  status      ComplianceTaskStatus @default(OPEN)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, dueOn])
}

model TenantCurrency {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
  name          String
  symbol        String
  decimalPlaces Int      @default(2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  tenantId     String
  currencyCode String
  effectiveOn  DateTime @db.Date
  rateToBase   Decimal  @db.Decimal(24, 12)
  source       String   @default("MANUAL")
  createdById  String
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, currencyCode, effectiveOn])
  @@index([tenantId, currencyCode, effectiveOn])
}

model StaffTenantAssignment {
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
}

model AccountingPeriod {
  id                            String                   @id @default(cuid())
  tenantId                      String
  name                          String
  startsOn                      DateTime                 @db.Date
  endsOn                        DateTime                 @db.Date
  status                        PeriodStatus             @default(OPEN)
  lockedAt                      DateTime?
  tenant                        Tenant                   @relation(fields: [tenantId], references: [id])
  journals                      Journal[]
  reports                       ReportVersion[]
  salesInvoices                 SalesInvoice[]
  supplierBills                 SupplierBill[]
  salesCreditNotes              SalesCreditNote[]
  supplierCreditNotes           SupplierCreditNote[]
  customerReceipts              CustomerReceipt[]
  supplierPayments              SupplierPayment[]
  directPayments                Payment[]
  interAccountTransfers         InterAccountTransfer[]
  dailyCashRegisters            DailyCashRegister[]
  inventoryOperations           InventoryOperation[]
  payrollRuns                   PayrollRun[]
  fixedAssetDepreciationEntries FixedAssetDepreciation[]
  fixedAssetDisposals           FixedAssetDisposal[]
  payrollSettlements            PayrollSettlement[]
  monthEndChecklistItems        MonthEndChecklistItem[]

  @@unique([tenantId, startsOn, endsOn])
  @@index([tenantId, status])
}

model MonthEndChecklistItem {
  id            String           @id @default(cuid())
  tenantId      String
  periodId      String
  key           String
  label         String
  completed     Boolean          @default(false)
  completedById String?
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period        AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  completedBy   User?            @relation("MonthEndChecklistCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([periodId, key])
  @@index([tenantId, periodId])
}

model ReferenceSequence {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  year      Int
  nextValue Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, year])
  @@index([tenantId])
}

model Employee {
  id                   String         @id @default(cuid())
  tenantId             String
  employeeNumber       String
  fullName             String
  identityReference    String?
  citizenship          String
  identityCardCategory String?
  schemeEligible       Boolean        @default(true)
  payFrequency         PayFrequency   @default(MONTHLY)
  basicSalary          Decimal        @db.Decimal(19, 4)
  hourlyRate           Decimal?       @db.Decimal(19, 4)
  department           String?
  employmentStart      DateTime       @db.Date
  employmentEnd        DateTime?      @db.Date
  status               EmployeeStatus @default(ACTIVE)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  tenant               Tenant         @relation(fields: [tenantId], references: [id])
  payrollEntries       PayrollEntry[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status, fullName])
}

model SpkRateBand {
  id                    String    @id @default(cuid())
  tenantId              String
  name                  String
  effectiveFrom         DateTime  @db.Date
  effectiveTo           DateTime? @db.Date
  salaryFrom            Decimal   @db.Decimal(19, 4)
  salaryTo              Decimal?  @db.Decimal(19, 4)
  employeeRatePercent   Decimal   @db.Decimal(7, 4)
  employerRatePercent   Decimal?  @db.Decimal(7, 4)
  employerFixedAmount   Decimal?  @db.Decimal(19, 4)
  minimumEmployerAmount Decimal?  @db.Decimal(19, 4)
  isDemonstration       Boolean   @default(true)
  createdAt             DateTime  @default(now())
  tenant                Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name, effectiveFrom])
  @@index([tenantId, effectiveFrom, effectiveTo])
}

model PayrollRun {
  id           String              @id @default(cuid())
  tenantId     String
  periodId     String
  reference    String
  payDate      DateTime            @db.Date
  status       PayrollRunStatus    @default(DRAFT)
  runType      PayrollRunType      @default(REGULAR)
  createdById  String
  approvedById String?
  postedAt     DateTime?
  lockedAt     DateTime?
  journalId    String?             @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  period       AccountingPeriod    @relation(fields: [periodId], references: [id])
  creator      User                @relation(fields: [createdById], references: [id])
  entries      PayrollEntry[]
  settlements  PayrollSettlement[]

  @@unique([tenantId, reference])
  @@index([tenantId, payDate, status])
}

model PayrollEntry {
  id              String     @id @default(cuid())
  payrollRunId    String
  employeeId      String
  basicPay        Decimal    @db.Decimal(19, 4)
  overtime        Decimal    @default(0) @db.Decimal(19, 4)
  allowances      Decimal    @default(0) @db.Decimal(19, 4)
  bonuses         Decimal    @default(0) @db.Decimal(19, 4)
  leavePayout     Decimal    @default(0) @db.Decimal(19, 4)
  gratuity        Decimal    @default(0) @db.Decimal(19, 4)
  otherEarnings   Decimal    @default(0) @db.Decimal(19, 4)
  otherDeductions Decimal    @default(0) @db.Decimal(19, 4)
  employeeSpk     Decimal    @default(0) @db.Decimal(19, 4)
  employerSpk     Decimal    @default(0) @db.Decimal(19, 4)
  grossPay        Decimal    @db.Decimal(19, 4)
  netPay          Decimal    @db.Decimal(19, 4)
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model PayrollSettlement {
  id            String           @id @default(cuid())
  tenantId      String
  payrollRunId  String
  periodId      String
  bankAccountId String
  reference     String
  paymentDate   DateTime         @db.Date
  amount        Decimal          @db.Decimal(19, 4)
  journalId     String           @unique
  notes         String?
  createdById   String
  createdAt     DateTime         @default(now())
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payrollRun    PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
